{
  "name": "azure-cn-capability-dashboard",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:build": "../.venv/bin/python ../scripts/build_capability_dashboard.py",
    "predev": "npm run data:build",
