# AzureCNArchaeologist Blob 发布配置
#
# 1. 复制本文件为 .env：cp .env_example .env
# 2. 只在 .env 中填写真实凭据；.env 已被 Git 忽略
# 3. 目标容器必须预先存在，程序不会自动创建容器

# Azure Storage Account 连接串（敏感信息，禁止提交真实值）
# Azure 中国区示例格式：
# DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.chinacloudapi.cn
AZURE_STORAGE_CONNECTION_STRING=

# CMS 消费 Payload 的目标 Blob 容器名称
AZURE_BLOB_CONTAINER_NAME=cms-output
