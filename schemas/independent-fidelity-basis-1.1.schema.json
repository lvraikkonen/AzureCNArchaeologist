{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/independent-fidelity-basis-1.1.schema.json",
  "title": "Independent Fidelity Reconstruction Basis 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basis_id",
    "batch_binding",
    "item_identity",
    "source_identity",
    "product_definition_identity",
    "soft_category_identity",
    "route_map_basis",
    "persisted_payload_identity",
    "verifier_profile",
    "reconstruction_profile_version",
    "wire_transform_version",
    "comparison_version",
    "scopes",
    "basis_semantic_identity"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "basis_id": { "type": "string", "minLength": 1 },
    "batch_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "input_manifest",
        "batch_manifest",
        "producer_commit"
      ],
      "properties": {
        "batch_id": { "type": "string", "minLength": 1 },
        "input_manifest": { "$ref": "#/$defs/pathSha" },
        "batch_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "revision"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "revision": { "type": "integer", "minimum": 0 }
          }
        },
        "producer_commit": { "$ref": "#/$defs/gitObjectId" }
      }
    },
    "item_identity": { "$ref": "#/$defs/itemIdentity" },
    "source_identity": { "$ref": "#/$defs/pathSha" },
    "product_definition_identity": { "$ref": "#/$defs/pathSha" },
    "soft_category_identity": { "$ref": "#/$defs/nullablePathSha" },
    "route_map_basis": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/routeMapBasis" }
      ]
    },
    "persisted_payload_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "batch_revision"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "batch_revision": { "type": "integer", "minimum": 0 }
      }
    },
    "verifier_profile": { "$ref": "#/$defs/profileIdentity" },
    "reconstruction_profile_version": {
      "const": "independent-four-family-reconstruction-v1"
    },
    "wire_transform_version": { "const": "independent-cms-wire-v2" },
    "comparison_version": { "const": "independent-content-comparison-v2" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scopeBasis" }
    },
    "basis_semantic_identity": { "$ref": "#/$defs/semanticIdentity" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^/|(?:^|/)\\.\\.(?:/|$)" }
    },
    "pathSha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullablePathSha": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pathSha" }
      ]
    },
    "itemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "language",
        "resource_key",
        "product_key",
        "resource_kind",
        "page_family"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "language": { "enum": ["zh-cn", "en-us"] },
        "resource_key": { "type": "string", "minLength": 1 },
        "product_key": { "type": "string", "minLength": 1 },
        "resource_kind": { "enum": ["current", "historical_version"] },
        "page_family": {
          "enum": [
            "region_filter",
            "complex",
            "simple_static",
            "support_article"
          ]
        }
      }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filterKey", "matchValues"],
      "properties": {
        "filterKey": { "type": "string", "minLength": 1 },
        "matchValues": { "type": "string", "minLength": 1 }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "boundary"],
      "properties": {
        "kind": {
          "enum": [
            "selector",
            "post_selector_siblings",
            "support_main_content"
          ]
        },
        "selector": { "type": ["string", "null"] },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "scopeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_key",
        "scope_kind",
        "criteria",
        "source_locator",
        "payload_locator",
        "expected_group_name",
        "retained_table_ids",
        "removed_table_ids"
      ],
      "properties": {
        "scope_key": { "type": "string", "minLength": 1 },
        "scope_kind": {
          "enum": ["interactive", "page_global", "full_content"]
        },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        },
        "source_locator": { "$ref": "#/$defs/sourceLocator" },
        "payload_locator": {
          "enum": [
            "contentGroups[].content",
            "baseContent",
            "mainContent"
          ]
        },
        "expected_group_name": { "type": ["string", "null"] },
        "retained_table_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "removed_table_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routeMapBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "entries"],
      "properties": {
        "source_url": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_route", "cms_path"],
            "properties": {
              "source_route": { "type": "string", "minLength": 1 },
              "cms_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "semanticIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
