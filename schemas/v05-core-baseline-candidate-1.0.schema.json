{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/v05-core-baseline-candidate-1.0.schema.json",
  "title": "v0.5 Core Successor Baseline Candidate 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "baseline_id",
    "source_batch_id",
    "reason",
    "generated_at",
    "baseline_root",
    "files",
    "candidate_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "baseline_id": { "const": "v0.5.1-core-baseline" },
    "source_batch_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "reason": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "baseline_root": { "const": "tests/fixtures/v0.5/core/baselines" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "candidate_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "old_sha256", "new_sha256", "status"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^/|(?:^|/)\\.\\.(?:/|$)" }
        },
        "old_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "new_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["added", "modified"] }
      }
    }
  }
}
