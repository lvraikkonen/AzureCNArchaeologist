{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/step3-capability-probe-1.0.schema.json",
  "title": "Step 3 Capability Probe Evidence 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "probe",
    "scope",
    "provenance",
    "formal_pipeline_blockers",
    "summary",
    "products",
    "manual_review_queue",
    "out_of_scope_pricing_product_definitions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "probe": {
      "$ref": "#/$defs/probe"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "formal_pipeline_blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formalBlocker"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "products": {
      "type": "array",
      "minItems": 105,
      "maxItems": 105,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "manual_review_queue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manualReviewQueueItem"
      }
    },
    "out_of_scope_pricing_product_definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outOfScopeProduct"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "textOrNull": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dateTimeOrNull": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "system_capability",
        "formal_batch_created",
        "reproducible_batch",
        "bilingual_pair_validation_executed",
        "note"
      ],
      "properties": {
        "kind": {
          "const": "non_batch_formal_single_product_extraction_and_persisted_validation"
        },
        "system_capability": {
          "type": "string",
          "minLength": 1
        },
        "formal_batch_created": {
          "type": "boolean"
        },
        "reproducible_batch": {
          "type": "boolean"
        },
        "bilingual_pair_validation_executed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "unique_entry_count",
        "pricing_product_definitions_total",
        "out_of_scope_product_definition_count",
        "languages",
        "support_articles_in_scope"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "unique_entry_count": {
          "const": 105
        },
        "pricing_product_definitions_total": {
          "type": "integer",
          "minimum": 105
        },
        "out_of_scope_product_definition_count": {
          "type": "integer",
          "minimum": 0
        },
        "languages": {
          "type": "array",
          "prefixItems": [
            {
              "const": "zh-cn"
            },
            {
              "const": "en-us"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "support_articles_in_scope": {
          "const": false
        }
      }
    },
    "pathSha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "idPathSha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "productIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "catalog_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_branch",
        "git_commit",
        "product_index",
        "soft_category",
        "validation_profile",
        "planning_overlay"
      ],
      "properties": {
        "git_branch": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "product_index": {
          "$ref": "#/$defs/productIndex"
        },
        "soft_category": {
          "$ref": "#/$defs/pathSha"
        },
        "validation_profile": {
          "$ref": "#/$defs/idPathSha"
        },
        "planning_overlay": {
          "$ref": "#/$defs/idPathSha"
        }
      }
    },
    "blockerCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity_drift",
        "normalized_input_identity_drift",
        "product_definition_identity_drift",
        "total_differences"
      ],
      "properties": {
        "source_identity_drift": {
          "type": "integer",
          "minimum": 0
        },
        "normalized_input_identity_drift": {
          "type": "integer",
          "minimum": 0
        },
        "product_definition_identity_drift": {
          "type": "integer",
          "minimum": 0
        },
        "total_differences": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "formalBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "counts": {
          "$ref": "#/$defs/blockerCounts"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "known_unsupported",
        "bilingual_machine_pass",
        "single_language_machine_pass",
        "bilingual_machine_fail",
        "machine_passed_language_items",
        "manual_review_product_count",
        "manual_review_language_item_count",
        "zh-cn_pass",
        "zh-cn_fail",
        "en-us_pass",
        "en-us_fail"
      ],
      "properties": {
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "known_unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "bilingual_machine_pass": {
          "type": "integer",
          "minimum": 0
        },
        "single_language_machine_pass": {
          "type": "integer",
          "minimum": 0
        },
        "bilingual_machine_fail": {
          "type": "integer",
          "minimum": 0
        },
        "machine_passed_language_items": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_product_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_language_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "zh-cn_pass": {
          "type": "integer",
          "minimum": 0
        },
        "zh-cn_fail": {
          "type": "integer",
          "minimum": 0
        },
        "en-us_pass": {
          "type": "integer",
          "minimum": 0
        },
        "en-us_fail": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "languageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "source_size_bytes",
        "execution",
        "validation",
        "machine_passed",
        "payload",
        "diagnostic",
        "content_group_count",
        "error",
        "validation_errors",
        "validation_warnings"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "execution": {
          "enum": [
            "not_run",
            "succeeded",
            "failed"
          ]
        },
        "validation": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "machine_passed": {
          "type": "boolean"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/payload"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic": {
          "oneOf": [
            {
              "$ref": "#/$defs/diagnostic"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_group_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "validation_warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "machine_passed": {
                "const": true
              }
            },
            "required": [
              "machine_passed"
            ]
          },
          "then": {
            "properties": {
              "execution": {
                "const": "succeeded"
              },
              "validation": {
                "const": "passed"
              },
              "payload": {
                "$ref": "#/$defs/payload"
              },
              "content_group_count": {
                "type": "integer",
                "minimum": 0
              },
              "error": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "payload": {
                "type": "null"
              },
              "content_group_count": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "bilingualValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "not_run_incomplete_pair",
            "not_run_no_complete_pair",
            "passed"
          ]
        },
        "source_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "probeManualValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "languages",
        "reviewer",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "not_applicable_no_machine_passed_payload"
          ]
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "zh-cn",
              "en-us"
            ]
          }
        },
        "reviewer": {
          "$ref": "#/$defs/textOrNull"
        },
        "reviewed_at": {
          "$ref": "#/$defs/dateTimeOrNull"
        },
        "notes": {
          "$ref": "#/$defs/textOrNull"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "product_key",
        "slug",
        "catalog_categories",
        "url",
        "capability_status",
        "unsupported_reason",
        "languages",
        "bilingual_machine_validation",
        "manual_content_validation"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "product_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "catalog_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "capability_status": {
          "enum": [
            "supported",
            "known_unsupported"
          ]
        },
        "unsupported_reason": {
          "$ref": "#/$defs/textOrNull"
        },
        "languages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh-cn",
            "en-us"
          ],
          "properties": {
            "zh-cn": {
              "$ref": "#/$defs/languageEvidence"
            },
            "en-us": {
              "$ref": "#/$defs/languageEvidence"
            }
          }
        },
        "bilingual_machine_validation": {
          "$ref": "#/$defs/bilingualValidation"
        },
        "manual_content_validation": {
          "$ref": "#/$defs/probeManualValidation"
        }
      }
    },
    "manualReviewQueueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_key",
        "display_name",
        "language",
        "source_sha256",
        "payload_path",
        "payload_sha256",
        "content_group_count",
        "manual_validation_status",
        "reviewer",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "product_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "zh-cn",
            "en-us"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_path": {
          "type": "string",
          "minLength": 1
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_validation_status": {
          "const": "pending"
        },
        "reviewer": {
          "$ref": "#/$defs/textOrNull"
        },
        "reviewed_at": {
          "$ref": "#/$defs/dateTimeOrNull"
        },
        "notes": {
          "$ref": "#/$defs/textOrNull"
        }
      }
    },
    "outOfScopeProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_key",
        "slug",
        "capability_status",
        "reason"
      ],
      "properties": {
        "product_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "capability_status": {
          "enum": [
            "supported",
            "known_unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
