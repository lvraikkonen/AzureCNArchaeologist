{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/dashboard-review-history-index-1.0.schema.json",
  "title": "Dashboard Review History Index 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batches"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_id"
        ],
        "properties": {
          "batch_id": {
            "$ref": "#/$defs/batch_id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    }
  }
}
