{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/rendering-profile-1.0.schema.json",
  "title": "Rendering Profile 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "viewport", "zoom_percent", "device_scale_factor", "approval_use", "pending_p4_identities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "status": {"const": "identity_frozen_pending_p4_calibration"},
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"const": 1440}, "height": {"const": 900}}
    },
    "zoom_percent": {"const": 100},
    "device_scale_factor": {"const": 1},
    "approval_use": {"const": "prohibited_until_p4_calibration"},
    "pending_p4_identities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "items": {"enum": ["chromium", "fonts", "template", "css"]}
    }
  }
}
