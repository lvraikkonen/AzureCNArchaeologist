{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/applicability-map-1.0.schema.json",
  "title": "Applicability Map Registry 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "status", "approval_use", "strategy_requirements", "legacy_candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "map_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "status": {"const": "identity_frozen_pending_p3_population"},
    "approval_use": {"const": "prohibited_until_p3_population"},
    "strategy_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simple_static", "region_filter", "complex", "support_article"],
      "properties": {
        "simple_static": {"const": "not_applicable"},
        "region_filter": {"const": "required"},
        "complex": {"const": "required"},
        "support_article": {"const": "not_applicable"}
      }
    },
    "legacy_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    }
  }
}
