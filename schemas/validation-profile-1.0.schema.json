{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/validation-profile-1.0.schema.json",
  "title": "Validation Profile 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "contracts", "input_assurance", "source_finding_severity", "min_content_length_by_product"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "status": {"const": "frozen"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_definition", "flexible_content", "support_article", "diagnostic_sidecar"],
      "properties": {
        "product_definition": {"$ref": "#/$defs/contract"},
        "flexible_content": {"$ref": "#/$defs/contract"},
        "support_article": {"$ref": "#/$defs/contract"},
        "diagnostic_sidecar": {"$ref": "#/$defs/contract"}
      }
    },
    "input_assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_input_byte_identical", "encoding", "preserve_utf8_bom", "reconstruction_parseability", "material_difference_disposition"],
      "properties": {
        "normalized_input_byte_identical": {"const": true},
        "encoding": {"const": "utf-8-strict"},
        "preserve_utf8_bom": {"const": true},
        "reconstruction_parseability": {"const": "beautifulsoup-html.parser-vs-lxml.html"},
        "material_difference_disposition": {"const": "blocking"}
      }
    },
    "source_finding_severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["charset_declaration_not_utf8", "charset_declarations_conflict", "charset_bom_conflict"],
      "properties": {
        "charset_declaration_not_utf8": {"const": "finding"},
        "charset_declarations_conflict": {"const": "finding"},
        "charset_bom_conflict": {"const": "finding"}
      }
    },
    "min_content_length_by_product": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "path", "sha256"],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
