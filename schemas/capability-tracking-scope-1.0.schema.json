{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/capability-tracking-scope-1.0.schema.json",
  "title": "Pricing Capability Tracking Scope 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "status",
    "frozen_at",
    "authority",
    "languages",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "status": {
      "const": "frozen"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "type": "array",
      "prefixItems": [
        {
          "const": "zh-cn"
        },
        {
          "const": "en-us"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "products": {
      "type": "array",
      "minItems": 105,
      "maxItems": 105,
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_key",
        "display_name",
        "slug",
        "catalog_categories",
        "url",
        "semantic_strategy"
      ],
      "properties": {
        "product_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "catalog_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.azure\\.cn/pricing/details/"
        },
        "semantic_strategy": {
          "oneOf": [
            {
              "enum": [
                "simple_static",
                "region_filter",
                "complex"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
