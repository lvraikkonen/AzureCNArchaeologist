{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/diagnostic-sidecar-1.2.schema.json",
  "title": "Diagnostic Sidecar 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_key",
    "resource",
    "language",
    "page_model",
    "contract",
    "source",
    "normalized_input",
    "payload",
    "strategy",
    "status",
    "validation",
    "timing",
    "error",
    "input_assurance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "product_key": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "$ref": "#/$defs/resource"
    },
    "language": {
      "enum": [
        "zh-cn",
        "en-us"
      ]
    },
    "page_model": {
      "enum": [
        "FlexibleContentPage",
        "SupportArticlePage"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "schema_sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "$ref": "#/$defs/artifact"
    },
    "normalized_input": {
      "$ref": "#/$defs/artifact"
    },
    "payload": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "processor"
      ],
      "properties": {
        "type": {
          "enum": [
            "not_selected",
            "simple_static",
            "region_filter",
            "complex",
            "support_article"
          ]
        },
        "processor": {
          "type": "string",
          "minLength": 1
        },
        "complexity_score": {
          "type": "number"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "region_projected_shared_content_evidence": {
          "$ref": "#/$defs/region_projected_shared_content_summary"
        },
        "strict_soft_category_projection_evidence": {
          "$ref": "#/$defs/strict_soft_category_projection_summary"
        },
        "strict_soft_category_projection_failure": {
          "$ref": "#/$defs/strict_soft_category_projection_failure"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "validation",
        "review",
        "publication"
      ],
      "properties": {
        "execution": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "validation": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "review": {
          "enum": [
            "not_requested",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "publication": {
          "enum": [
            "not_published",
            "published"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at",
        "duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "stage",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "input_assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "encoding",
        "has_utf8_bom",
        "source_normalized_byte_identical",
        "source_findings",
        "reconstruction_parseability",
        "source_html_structure"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "encoding": {
          "const": "utf-8-strict"
        },
        "has_utf8_bom": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_normalized_byte_identical": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_finding"
          }
        },
        "reconstruction_parseability": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "input_sha256",
                "profile_sha256",
                "evidence"
              ],
              "properties": {
                "verdict": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                },
                "input_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "profile_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidence": {
                  "$ref": "#/$defs/artifact"
                }
              }
            }
          ]
        },
        "source_html_structure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "auditor_version",
                "input_sha256",
                "evidence"
              ],
              "properties": {
                "schema_version": {
                  "type": "string",
                  "minLength": 1
                },
                "auditor_version": {
                  "type": "string",
                  "minLength": 1
                },
                "input_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidence": {
                  "$ref": "#/$defs/artifact"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "required": [
              "region_projected_shared_content_evidence"
            ]
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "properties": {
          "page_model": {
            "const": "FlexibleContentPage"
          },
          "strategy": {
            "properties": {
              "type": {
                "const": "complex"
              }
            }
          },
          "status": {
            "properties": {
              "execution": {
                "const": "succeeded"
              }
            }
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategy": {
            "required": [
              "strict_soft_category_projection_evidence"
            ]
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "properties": {
          "strategy": {
            "properties": {
              "type": {
                "const": "complex"
              }
            },
            "not": {
              "required": [
                "strict_soft_category_projection_failure"
              ]
            }
          },
          "status": {
            "properties": {
              "execution": {
                "const": "succeeded"
              }
            }
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategy": {
            "required": [
              "strict_soft_category_projection_failure"
            ]
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "properties": {
          "strategy": {
            "properties": {
              "type": {
                "enum": [
                  "not_selected",
                  "complex"
                ]
              }
            },
            "not": {
              "required": [
                "strict_soft_category_projection_evidence"
              ]
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "strategy": {
                "properties": {
                  "type": {
                    "const": "not_selected"
                  },
                  "strict_soft_category_projection_failure": {
                    "properties": {
                      "phase": {
                        "const": "source_reachability"
                      }
                    }
                  }
                }
              },
              "status": {
                "properties": {
                  "execution": {
                    "const": "failed"
                  }
                }
              },
              "error": {
                "type": "object"
              }
            }
          },
          {
            "properties": {
              "strategy": {
                "properties": {
                  "type": {
                    "const": "complex"
                  },
                  "strict_soft_category_projection_failure": {
                    "properties": {
                      "phase": {
                        "enum": [
                          "attach",
                          "strategy_replay"
                        ]
                      }
                    }
                  }
                }
              },
              "status": {
                "properties": {
                  "execution": {
                    "const": "failed"
                  }
                }
              },
              "error": {
                "type": "object"
              }
            }
          },
          {
            "properties": {
              "strategy": {
                "properties": {
                  "type": {
                    "const": "complex"
                  },
                  "strict_soft_category_projection_failure": {
                    "properties": {
                      "phase": {
                        "enum": [
                          "validation_replay",
                          "bilingual_replay",
                          "source_reachability"
                        ]
                      }
                    }
                  }
                }
              },
              "status": {
                "properties": {
                  "execution": {
                    "const": "succeeded"
                  },
                  "validation": {
                    "const": "failed"
                  }
                }
              },
              "error": {
                "type": "null"
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resource_key",
        "slug",
        "version_key",
        "version_label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "current",
            "historical_version"
          ]
        },
        "resource_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:--v[0-9]+(?:-[0-9]+)*)?$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version_key": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^v[0-9]+(?:-[0-9]+)*$"
            }
          ]
        },
        "version_label": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "region_projected_shared_content_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "projection_algorithms",
        "applicability_configs",
        "evidence_sha256s",
        "aggregate_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "projection_algorithms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "exact-table-id-nearest-scroll-table-v1"
          }
        },
        "applicability_configs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "evidence_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "aggregate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "strict_soft_category_projection_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "projection_algorithms",
        "applicability_configs",
        "state_count",
        "evidence_sha256s",
        "aggregate_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "projection_algorithms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "strict-soft-category-leaf-state-v1"
          }
        },
        "applicability_configs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "state_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_sha256s": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "aggregate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "strict_soft_category_projection_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "code",
        "phase",
        "state_scope",
        "configuration",
        "source_inventory",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "attach",
            "strategy_replay",
            "validation_replay",
            "bilingual_replay",
            "source_reachability"
          ]
        },
        "state_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "software",
            "source_panel_id"
          ],
          "properties": {
            "region": {
              "type": [
                "string",
                "null"
              ]
            },
            "software": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_panel_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            }
          }
        },
        "source_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_panel_id",
            "source_table_count",
            "source_idless_table_count",
            "source_table_ids",
            "source_html_sha256"
          ],
          "properties": {
            "source_panel_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_table_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "source_idless_table_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "source_table_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_html_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            }
          }
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "source_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "code",
        "category",
        "severity",
        "message",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "code": {
          "enum": [
            "SOURCE_CHARSET_BOM_CONFLICT",
            "SOURCE_CHARSET_DECLARATIONS_CONFLICT",
            "SOURCE_CHARSET_DECLARATION_NOT_UTF8"
          ]
        },
        "category": {
          "const": "charset"
        },
        "severity": {
          "const": "warning"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actual_encoding",
            "utf8_bom",
            "declarations"
          ],
          "properties": {
            "actual_encoding": {
              "const": "utf-8"
            },
            "utf8_bom": {
              "type": "boolean"
            },
            "declarations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "value",
                  "normalized"
                ],
                "properties": {
                  "source": {
                    "enum": [
                      "meta_charset",
                      "http_equiv"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "normalized": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
