{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/step6-core-determinism-record-1.0.schema.json",
  "title": "Step 6 Core Determinism Record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "comparator",
    "left",
    "right",
    "common_inputs",
    "comparison",
    "record_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "core-determinism-comparator-v1" },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sampled_normalization",
        "validation_normalization",
        "promotion_inputs_normalization"
      ],
      "properties": {
        "id": { "const": "core-determinism-comparator-v1" },
        "sampled_normalization": { "const": "core-determinism-sampled-normalization-v1" },
        "validation_normalization": { "const": "core-determinism-validation-normalization-v1" },
        "promotion_inputs_normalization": { "const": "core-determinism-promotion-inputs-v1" }
      }
    },
    "left": { "$ref": "#/$defs/run_side" },
    "right": { "$ref": "#/$defs/run_side" },
    "common_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning", "validation_context", "frozen_inputs", "items"],
      "properties": {
        "planning": { "type": "object" },
        "validation_context": { "type": "object" },
        "frozen_inputs": { "type": "object" },
        "items": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "frozen_item_sha256"],
            "properties": {
              "item_id": { "$ref": "#/$defs/item_id" },
              "frozen_item_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "total_items", "matched_items", "items"],
      "properties": {
        "status": { "const": "passed" },
        "total_items": { "const": 8 },
        "matched_items": { "const": 8 },
        "items": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/comparison_item" }
        }
      }
    },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "item_id": {
      "enum": [
        "zh-cn/api-management",
        "en-us/api-management",
        "zh-cn/cloud-services",
        "en-us/cloud-services",
        "zh-cn/service-bus",
        "en-us/service-bus",
        "zh-cn/icp-faq",
        "en-us/icp-faq"
      ]
    },
    "run_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "provenance", "summary"],
      "properties": {
        "batch_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git_commit",
            "worktree_fingerprint",
            "immutable_fingerprint"
          ],
          "properties": {
            "git_commit": { "$ref": "#/$defs/sha256" },
            "worktree_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "immutable_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "total",
            "execution_succeeded",
            "validation_passed",
            "review_pending",
            "not_released",
            "not_published"
          ],
          "properties": {
            "status": { "const": "completed" },
            "total": { "const": 8 },
            "execution_succeeded": { "const": 8 },
            "validation_passed": { "const": 8 },
            "review_pending": { "const": 8 },
            "not_released": { "const": 8 },
            "not_published": { "const": 8 }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_artifact_sha256",
        "sampled_content_artifact_sha256",
        "sampled_content_evidence_sha256",
        "validation_artifact_sha256",
        "validation_evidence_sha256",
        "sampling_plan_artifact_sha256",
        "sampling_plan_sha256"
      ],
      "properties": {
        "payload_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "sampled_content_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "sampled_content_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "validation_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "validation_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "sampling_plan_artifact_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "sampling_plan_sha256": { "$ref": "#/$defs/nullable_sha256" }
      }
    },
    "comparison_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "payload_sha256",
        "sampling_plan_sha256",
        "sampled_content_semantic_sha256",
        "validation_semantic_identity",
        "promotion_inputs_sha256",
        "left_integrity",
        "right_integrity"
      ],
      "properties": {
        "item_id": { "$ref": "#/$defs/item_id" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "sampling_plan_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "sampled_content_semantic_sha256": { "$ref": "#/$defs/sha256" },
        "validation_semantic_identity": { "$ref": "#/$defs/sha256" },
        "promotion_inputs_sha256": { "$ref": "#/$defs/sha256" },
        "left_integrity": { "$ref": "#/$defs/integrity" },
        "right_integrity": { "$ref": "#/$defs/integrity" }
      }
    }
  }
}
