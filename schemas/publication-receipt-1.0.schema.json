{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/publication-receipt-1.0.schema.json",
  "title": "Publication Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "published_at",
    "batch_id",
    "release_id",
    "release_manifest",
    "release_seal",
    "target",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "$ref": "#/$defs/sha256"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "release_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "release_seal": {
      "$ref": "#/$defs/sha256"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/receipt_item"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_url",
        "container",
        "prefix"
      ],
      "properties": {
        "account_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "container": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?$"
        },
        "prefix": {
          "type": "string",
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            ]
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_path",
        "sha256"
      ],
      "properties": {
        "release_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "target_blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "name"
      ],
      "properties": {
        "container": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?$"
        },
        "name": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_url",
        "container",
        "name",
        "sha256",
        "content_length",
        "etag"
      ],
      "properties": {
        "account_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "container": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?$"
        },
        "name": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_length": {
          "type": "integer",
          "minimum": 0
        },
        "etag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "receipt_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "resource_key",
        "language",
        "payload",
        "target_blob",
        "remote"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "language": {
          "enum": [
            "zh-cn",
            "en-us"
          ]
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "target_blob": {
          "$ref": "#/$defs/target_blob"
        },
        "remote": {
          "$ref": "#/$defs/remote"
        }
      }
    }
  }
}
