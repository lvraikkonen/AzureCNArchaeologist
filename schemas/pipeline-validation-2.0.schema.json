{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/pipeline-validation-2.0.schema.json",
  "title": "Pipeline Validation Projection 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "item_id",
    "status",
    "evidence_sha256",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "verdict": {
                "const": "passed"
              },
              "structure_validation": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "content_validation": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "errors": {
                "maxItems": 0
              },
              "approval_preconditions": {
                "properties": {
                  "machine": {
                    "properties": {
                      "eligible": {
                        "const": true
                      },
                      "blockers": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "verdict": {
                "const": "failed"
              },
              "errors": {
                "minItems": 1
              },
              "approval_preconditions": {
                "properties": {
                  "machine": {
                    "properties": {
                      "eligible": {
                        "const": false
                      },
                      "blockers": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            },
            "anyOf": [
              {
                "properties": {
                  "structure_validation": {
                    "properties": {
                      "status": {
                        "const": "failed"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "content_validation": {
                    "properties": {
                      "status": {
                        "const": "failed"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullable_artifact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-validation-p3"
        },
        "schema_version": {
          "const": "1.2"
        },
        "path": {
          "const": "data/configs/validation-profiles/v0.4-p3.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sampling_profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-content-sampling-p3"
        },
        "schema_version": {
          "const": "1.0"
        },
        "path": {
          "const": "data/configs/content-sampling-profiles/v0.4-p3.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "artifact_sha256",
        "plan_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "normalized_input",
        "payload",
        "soft_category",
        "validation_profile",
        "content_sampling_profile",
        "sampling_plan"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/artifact"
        },
        "normalized_input": {
          "$ref": "#/$defs/artifact"
        },
        "payload": {
          "$ref": "#/$defs/artifact"
        },
        "soft_category": {
          "$ref": "#/$defs/artifact"
        },
        "validation_profile": {
          "$ref": "#/$defs/profile_identity"
        },
        "content_sampling_profile": {
          "$ref": "#/$defs/sampling_profile_identity"
        },
        "sampling_plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/plan_binding"
            }
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "universe_count",
        "selected_count",
        "untested_count",
        "seed",
        "strata",
        "selected_state_ids",
        "assurance"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "stratified_sample"
          ]
        },
        "universe_count": {
          "type": "integer",
          "minimum": 1
        },
        "selected_count": {
          "type": "integer",
          "minimum": 1
        },
        "untested_count": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "strata": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "selected_state_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "assurance": {
          "const": "sampled_state_content_consistency"
        }
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_count",
        "total_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "checked_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "content_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sampled_content_evidence",
        "coverage",
        "claim"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "sampled_content_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "artifact_sha256",
            "evidence_sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relative_path"
            },
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "claim": {
          "const": "sampled_state_content_consistency"
        }
      }
    },
    "precondition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "blockers"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            },
            "required": [
              "eligible"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "approval_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "source"
      ],
      "properties": {
        "machine": {
          "$ref": "#/$defs/precondition_result"
        },
        "source": {
          "$ref": "#/$defs/precondition_result"
        }
      }
    },
    "source_quality_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path",
        "severity",
        "disposition"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "severity": {
          "const": "finding"
        },
        "disposition": {
          "const": "unresolved"
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "bindings",
        "structure_validation",
        "content_validation",
        "source_quality_findings",
        "approval_preconditions",
        "errors",
        "warnings"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "structure_validation": {
          "$ref": "#/$defs/validation_result"
        },
        "content_validation": {
          "$ref": "#/$defs/content_validation"
        },
        "source_quality_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_quality_finding"
          }
        },
        "approval_preconditions": {
          "$ref": "#/$defs/approval_preconditions"
        },
        "errors": {
          "$ref": "#/$defs/issues"
        },
        "warnings": {
          "$ref": "#/$defs/issues"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_quality_findings": {
                "minItems": 1
              }
            },
            "required": [
              "source_quality_findings"
            ]
          },
          "then": {
            "properties": {
              "approval_preconditions": {
                "properties": {
                  "source": {
                    "properties": {
                      "eligible": {
                        "const": false
                      },
                      "blockers": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_preconditions": {
                "properties": {
                  "source": {
                    "properties": {
                      "eligible": {
                        "const": true
                      }
                    },
                    "required": [
                      "eligible"
                    ]
                  }
                },
                "required": [
                  "source"
                ]
              }
            },
            "required": [
              "approval_preconditions"
            ]
          },
          "then": {
            "properties": {
              "source_quality_findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_validation": {
                "properties": {
                  "coverage": {
                    "properties": {
                      "mode": {
                        "const": "full"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  }
                },
                "required": [
                  "coverage"
                ]
              }
            },
            "required": [
              "content_validation"
            ]
          },
          "then": {
            "properties": {
              "bindings": {
                "properties": {
                  "sampling_plan": {
                    "type": "null"
                  }
                }
              },
              "content_validation": {
                "properties": {
                  "coverage": {
                    "properties": {
                      "untested_count": {
                        "const": 0
                      },
                      "seed": {
                        "type": "null"
                      },
                      "strata": {
                        "maxItems": 0
                      },
                      "selected_state_ids": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_validation": {
                "properties": {
                  "coverage": {
                    "properties": {
                      "mode": {
                        "const": "stratified_sample"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  }
                },
                "required": [
                  "coverage"
                ]
              }
            },
            "required": [
              "content_validation"
            ]
          },
          "then": {
            "properties": {
              "bindings": {
                "properties": {
                  "sampling_plan": {
                    "$ref": "#/$defs/plan_binding"
                  }
                }
              },
              "content_validation": {
                "properties": {
                  "coverage": {
                    "properties": {
                      "seed": {
                        "$ref": "#/$defs/sha256"
                      },
                      "strata": {
                        "minItems": 1
                      },
                      "selected_state_ids": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
