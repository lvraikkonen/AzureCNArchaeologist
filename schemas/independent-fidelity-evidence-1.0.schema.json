{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/independent-fidelity-evidence-1.0.schema.json",
  "title": "Independent Fidelity Evidence 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim",
    "verdict",
    "coverage",
    "identity",
    "reconstruction_basis",
    "verifier_profile",
    "reconstruction_profile_version",
    "wire_transform_version",
    "comparison_version",
    "states",
    "mismatches",
    "blocking_errors",
    "qualification_limitation",
    "blocked_reason",
    "evidence_semantic_identity",
    "review_projection_artifact_identity"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "claim": { "const": "independent_source_content_fidelity" },
    "verdict": { "$ref": "#/$defs/verdict" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "identity": { "$ref": "#/$defs/evidenceIdentity" },
    "reconstruction_basis": { "type": "object" },
    "verifier_profile": { "$ref": "#/$defs/profileIdentity" },
    "reconstruction_profile_version": {
      "const": "independent-state-reconstruction-v1"
    },
    "wire_transform_version": { "const": "independent-cms-wire-v1" },
    "comparison_version": { "const": "independent-html-comparison-v1" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stateEvidence" }
    },
    "mismatches": {
      "type": "array",
      "items": { "$ref": "#/$defs/mismatch" }
    },
    "blocking_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/blockingError" }
    },
    "qualification_limitation": { "type": ["string", "null"] },
    "blocked_reason": { "type": ["string", "null"] },
    "evidence_semantic_identity": { "$ref": "#/$defs/semanticIdentity" },
    "review_projection_artifact_identity": {
      "$ref": "#/$defs/projectionIdentity"
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^/|(?:^|/)\\.\\.(?:/|$)" }
    },
    "verdict": {
      "enum": ["passed", "failed", "blocked", "not_qualified", "not_run"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "completed", "passed", "failed", "blocked"],
      "properties": {
        "required": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "evidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "item_id",
        "language",
        "resource_key",
        "product_key"
      ],
      "properties": {
        "batch_id": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "language": { "enum": ["zh-cn", "en-us"] },
        "resource_key": { "type": "string", "minLength": 1 },
        "product_key": { "type": "string", "minLength": 1 }
      }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filterKey", "matchValues"],
      "properties": {
        "filterKey": { "type": "string", "minLength": 1 },
        "matchValues": { "type": "string", "minLength": 1 }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_selector",
        "content_selectors",
        "append_selectors"
      ],
      "properties": {
        "container_selector": { "type": "string", "minLength": 1 },
        "content_selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "append_selectors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fragmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "diffRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "dimension",
        "expected_sha256",
        "actual_sha256",
        "message"
      ],
      "properties": {
        "code": { "const": "content_mismatch" },
        "dimension": {
          "enum": ["raw", "dom", "tag_structure", "visible_text"]
        },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "actual_sha256": { "$ref": "#/$defs/sha256" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "blockingError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "stateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "criteria",
        "locator",
        "verdict",
        "source",
        "expected",
        "payload",
        "diff",
        "applied_transform_rule_ids",
        "retained_table_ids",
        "removed_table_ids",
        "mismatches",
        "blocking_errors"
      ],
      "properties": {
        "state_id": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        },
        "locator": { "$ref": "#/$defs/locator" },
        "verdict": {
          "enum": ["passed", "failed", "blocked"]
        },
        "source": { "$ref": "#/$defs/fragmentRef" },
        "expected": { "$ref": "#/$defs/fragmentRef" },
        "payload": { "$ref": "#/$defs/fragmentRef" },
        "diff": { "$ref": "#/$defs/diffRef" },
        "applied_transform_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "const": "css-generated-semantics-v1" }
        },
        "retained_table_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "removed_table_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "mismatches": {
          "type": "array",
          "items": { "$ref": "#/$defs/mismatch" }
        },
        "blocking_errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockingError" }
        }
      }
    },
    "semanticIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "projectionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "projectionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "artifacts", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-projection-artifacts-v1" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projectionArtifact" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
