{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/pipeline-validation-2.2.schema.json",
  "title": "Pipeline Validation Projection 2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "item_id",
    "status",
    "evidence_sha256",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "2.2"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.5.5-validation-product-definition-successor"
        },
        "schema_version": {
          "const": "1.4"
        },
        "path": {
          "const": "data/configs/validation-profiles/v0.5.5-product-definition-successor.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sampling_profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-content-sampling-p3"
        },
        "schema_version": {
          "const": "1.0"
        },
        "path": {
          "const": "data/configs/content-sampling-profiles/v0.4-p3.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finding_code_policy_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-finding-code-policy-p4"
        },
        "schema_version": {
          "const": "1.0"
        },
        "path": {
          "const": "data/configs/finding-code-policies/v0.4-p4.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "artifact_sha256",
        "plan_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "normalized_input",
        "payload",
        "soft_category",
        "validation_profile",
        "content_sampling_profile",
        "sampling_plan",
        "finding_code_policy_identity"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/artifact"
        },
        "normalized_input": {
          "$ref": "#/$defs/artifact"
        },
        "payload": {
          "$ref": "#/$defs/artifact"
        },
        "soft_category": {
          "$ref": "#/$defs/artifact"
        },
        "validation_profile": {
          "$ref": "#/$defs/profile_identity"
        },
        "content_sampling_profile": {
          "$ref": "#/$defs/sampling_profile_identity"
        },
        "sampling_plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/plan_binding"
            }
          ]
        },
        "finding_code_policy_identity": {
          "$ref": "#/$defs/finding_code_policy_identity"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "universe_count",
        "selected_count",
        "untested_count",
        "seed",
        "strata",
        "selected_state_ids",
        "assurance"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "stratified_sample"
          ]
        },
        "universe_count": {
          "type": "integer",
          "minimum": 1
        },
        "selected_count": {
          "type": "integer",
          "minimum": 1
        },
        "untested_count": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "strata": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "selected_state_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "assurance": {
          "const": "sampled_state_content_consistency"
        }
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_count",
        "total_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "checked_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "content_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sampled_content_evidence",
        "coverage",
        "claim"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "sampled_content_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "artifact_sha256",
            "evidence_sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relative_path"
            },
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "evidence_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "claim": {
          "const": "sampled_state_content_consistency"
        }
      }
    },
    "precondition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "blockers"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "approval_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "source"
      ],
      "properties": {
        "machine": {
          "$ref": "#/$defs/precondition_result"
        },
        "source": {
          "$ref": "#/$defs/precondition_result"
        }
      }
    },
    "source_quality_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path",
        "severity",
        "disposition",
        "classification"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "severity": {
          "const": "finding"
        },
        "disposition": {
          "const": "unresolved"
        },
        "classification": {
          "enum": [
            "advisory",
            "approval_blocking",
            "unknown"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "bindings",
        "structure_validation",
        "content_validation",
        "source_quality_findings",
        "approval_preconditions",
        "errors",
        "warnings"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "structure_validation": {
          "$ref": "#/$defs/validation_result"
        },
        "content_validation": {
          "$ref": "#/$defs/content_validation"
        },
        "source_quality_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_quality_finding"
          }
        },
        "approval_preconditions": {
          "$ref": "#/$defs/approval_preconditions"
        },
        "errors": {
          "$ref": "#/$defs/issues"
        },
        "warnings": {
          "$ref": "#/$defs/issues"
        }
      }
    }
  }
}
