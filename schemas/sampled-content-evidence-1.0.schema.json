{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/sampled-content-evidence-1.0.schema.json",
  "title": "Sampled Content Evidence 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_sha256",
    "item_id",
    "mode",
    "bindings",
    "coverage",
    "structure_validation",
    "page_global_comparison",
    "full_content_comparison",
    "samples",
    "errors",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "full",
        "stratified_sample"
      ]
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "structure_validation": {
      "$ref": "#/$defs/structure_validation"
    },
    "page_global_comparison": {
      "$ref": "#/$defs/comparison"
    },
    "full_content_comparison": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/comparison"
        }
      ]
    },
    "samples": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "errors": {
      "$ref": "#/$defs/issues"
    },
    "warnings": {
      "$ref": "#/$defs/issues"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "full"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "bindings": {
            "properties": {
              "sampling_plan": {
                "type": "null"
              }
            }
          },
          "coverage": {
            "properties": {
              "mode": {
                "const": "full"
              },
              "untested_count": {
                "const": 0
              },
              "seed": {
                "type": "null"
              },
              "strata": {
                "maxItems": 0
              },
              "selected_state_ids": {
                "maxItems": 0
              }
            }
          },
          "full_content_comparison": {
            "$ref": "#/$defs/comparison"
          },
          "samples": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "stratified_sample"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "bindings": {
            "properties": {
              "sampling_plan": {
                "$ref": "#/$defs/plan_binding"
              }
            }
          },
          "coverage": {
            "properties": {
              "mode": {
                "const": "stratified_sample"
              },
              "seed": {
                "$ref": "#/$defs/sha256"
              },
              "strata": {
                "minItems": 1
              },
              "selected_state_ids": {
                "minItems": 1
              }
            }
          },
          "full_content_comparison": {
            "type": "null"
          },
          "page_global_comparison": {
            "properties": {
              "status": {
                "enum": [
                  "matched",
                  "mismatched",
                  "failed"
                ]
              }
            }
          },
          "samples": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullable_artifact": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-validation-p3"
        },
        "schema_version": {
          "const": "1.2"
        },
        "path": {
          "const": "data/configs/validation-profiles/v0.4-p3.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sampling_profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-content-sampling-p3"
        },
        "schema_version": {
          "const": "1.0"
        },
        "path": {
          "const": "data/configs/content-sampling-profiles/v0.4-p3.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "artifact_sha256",
        "plan_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "normalized_input",
        "payload",
        "soft_category",
        "validation_profile",
        "content_sampling_profile",
        "sampling_plan"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/artifact"
        },
        "normalized_input": {
          "$ref": "#/$defs/artifact"
        },
        "payload": {
          "$ref": "#/$defs/artifact"
        },
        "soft_category": {
          "$ref": "#/$defs/artifact"
        },
        "validation_profile": {
          "$ref": "#/$defs/profile_identity"
        },
        "content_sampling_profile": {
          "$ref": "#/$defs/sampling_profile_identity"
        },
        "sampling_plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/plan_binding"
            }
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "universe_count",
        "selected_count",
        "untested_count",
        "seed",
        "strata",
        "selected_state_ids",
        "assurance"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "stratified_sample"
          ]
        },
        "universe_count": {
          "type": "integer",
          "minimum": 1
        },
        "selected_count": {
          "type": "integer",
          "minimum": 1
        },
        "untested_count": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "strata": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "selected_state_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "assurance": {
          "const": "sampled_state_content_consistency"
        }
      }
    },
    "structure_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "universe_count",
        "checked_count",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "universe_count": {
          "type": "integer",
          "minimum": 1
        },
        "checked_count": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "$ref": "#/$defs/issues"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_fingerprint",
        "payload_fingerprint",
        "diff_reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "mismatched",
            "failed",
            "not_applicable"
          ]
        },
        "source_fingerprint": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "payload_fingerprint": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "diff_reference": {
          "$ref": "#/$defs/nullable_artifact"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "matched"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "payload_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "diff_reference": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "mismatched"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "payload_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "diff_reference": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_fingerprint": {
                "type": "null"
              },
              "payload_fingerprint": {
                "type": "null"
              },
              "diff_reference": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "criterion": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "criteria"
      ],
      "properties": {
        "state_id": {
          "$ref": "#/$defs/sha256"
        },
        "criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source_fingerprint",
        "payload_fingerprint",
        "status",
        "diff_reference"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "source_fingerprint": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "payload_fingerprint": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "status": {
          "enum": [
            "matched",
            "mismatched",
            "failed"
          ]
        },
        "diff_reference": {
          "$ref": "#/$defs/nullable_artifact"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "matched"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "payload_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "diff_reference": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "mismatched"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "payload_fingerprint": {
                "$ref": "#/$defs/sha256"
              },
              "diff_reference": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
