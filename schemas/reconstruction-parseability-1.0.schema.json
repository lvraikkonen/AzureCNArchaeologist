{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/reconstruction-parseability-1.0.schema.json",
  "title": "Reconstruction Parseability Evidence 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_sha256",
    "profile",
    "parsers",
    "fingerprints",
    "differences",
    "source_findings",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "parsers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "independent"],
      "properties": {
        "production": {"$ref": "#/$defs/parser"},
        "independent": {"$ref": "#/$defs/parser"}
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "independent"],
      "properties": {
        "production": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]
        },
        "independent": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]
        }
      }
    },
    "differences": {
      "type": "array",
      "items": {"$ref": "#/$defs/difference"}
    },
    "source_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_finding"}
    },
    "verdict": {"enum": ["passed", "failed"]}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "error"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["parsed", "failed"]},
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "message"],
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "message": {"type": "string"}
              }
            }
          ]
        }
      }
    },
    "text_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "token_count"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "token_count": {"type": "integer", "minimum": 0}
      }
    },
    "main_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "sha256", "token_count"],
      "properties": {
        "selector": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "token_count": {"type": "integer", "minimum": 0}
      }
    },
    "critical_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "fingerprints"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "fingerprints": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "main",
        "pricing_tables",
        "critical_fragments"
      ],
      "properties": {
        "body": {"$ref": "#/$defs/text_fingerprint"},
        "main": {"$ref": "#/$defs/main_fingerprint"},
        "pricing_tables": {
          "type": "array",
          "items": {"$ref": "#/$defs/sha256"}
        },
        "critical_fragments": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/critical_fingerprint"}
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "production", "independent"],
      "properties": {
        "code": {
          "enum": [
            "BODY_TEXT_DIVERGENCE",
            "CRITICAL_FRAGMENT_DIVERGENCE",
            "MAIN_CONTENT_DIVERGENCE",
            "PARSER_FAILURE",
            "PRICING_TABLE_DIVERGENCE"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "production": {},
        "independent": {}
      }
    },
    "source_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "code",
        "category",
        "severity",
        "message",
        "evidence"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "code": {
          "enum": [
            "SOURCE_CHARSET_BOM_CONFLICT",
            "SOURCE_CHARSET_DECLARATIONS_CONFLICT",
            "SOURCE_CHARSET_DECLARATION_NOT_UTF8"
          ]
        },
        "category": {"const": "charset"},
        "severity": {"const": "warning"},
        "message": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actual_encoding", "utf8_bom", "declarations"],
          "properties": {
            "actual_encoding": {"const": "utf-8"},
            "utf8_bom": {"type": "boolean"},
            "declarations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "value", "normalized"],
                "properties": {
                  "source": {"enum": ["meta_charset", "http_equiv"]},
                  "value": {"type": "string", "minLength": 1},
                  "normalized": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
