{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/independent-fidelity-profile-1.1.schema.json",
  "title": "Independent Fidelity Profile 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "claim",
    "qualification",
    "allowed_dependencies",
    "forbidden_dependency_prefixes",
    "reconstruction_profile_version",
    "wire_transform_version",
    "comparison_version",
    "supported_transform_rule_ids",
    "verdicts"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "profile_id": { "const": "v0.5.3-independent-fidelity-four-family" },
    "profile_version": { "const": "0.5.3" },
    "claim": { "const": "independent_source_content_fidelity" },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_page_families", "unsupported_result"],
      "properties": {
        "supported_page_families": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "region_filter",
              "complex",
              "simple_static",
              "support_article"
            ]
          }
        },
        "unsupported_result": { "const": "not_qualified" }
      }
    },
    "allowed_dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_dependency_prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reconstruction_profile_version": {
      "const": "independent-four-family-reconstruction-v1"
    },
    "wire_transform_version": { "const": "independent-cms-wire-v2" },
    "comparison_version": { "const": "independent-content-comparison-v2" },
    "supported_transform_rule_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "css-generated-semantics-v1",
          "root-relative-assets-v1",
          "support-url-resolution-v1"
        ]
      }
    },
    "verdicts": {
      "type": "array",
      "prefixItems": [
        { "const": "passed" },
        { "const": "failed" },
        { "const": "blocked" },
        { "const": "not_qualified" },
        { "const": "not_run" }
      ],
      "minItems": 5,
      "maxItems": 5
    }
  }
}
