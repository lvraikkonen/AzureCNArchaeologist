{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/validation-profile-1.3.schema.json",
  "title": "Validation Profile 1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "base_profile",
    "content_sampling_profile",
    "finding_code_policy_identity",
    "contracts",
    "input_assurance",
    "source_finding_severity",
    "semantic_assurance",
    "min_content_length_by_product"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "profile_id": {
      "const": "v0.4-validation-p3-successor"
    },
    "status": {
      "const": "frozen"
    },
    "base_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-validation-p3"
        },
        "schema_version": {
          "const": "1.2"
        },
        "path": {
          "const": "data/configs/validation-profiles/v0.4-p3.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "content_sampling_profile": {
      "$ref": "#/$defs/content_sampling_profile_identity"
    },
    "finding_code_policy_identity": {
      "$ref": "#/$defs/finding_code_policy_identity"
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_definition",
        "flexible_content",
        "support_article",
        "diagnostic_sidecar",
        "source_html_structure_audit",
        "content_sampling_profile",
        "pipeline_validation",
        "batch_item_sampling_plan",
        "sampled_content_evidence",
        "finding_code_policy"
      ],
      "properties": {
        "product_definition": {
          "$ref": "#/$defs/contract"
        },
        "flexible_content": {
          "$ref": "#/$defs/contract"
        },
        "support_article": {
          "$ref": "#/$defs/contract"
        },
        "diagnostic_sidecar": {
          "$ref": "#/$defs/contract"
        },
        "source_html_structure_audit": {
          "$ref": "#/$defs/contract"
        },
        "content_sampling_profile": {
          "$ref": "#/$defs/contract"
        },
        "pipeline_validation": {
          "$ref": "#/$defs/contract"
        },
        "batch_item_sampling_plan": {
          "$ref": "#/$defs/contract"
        },
        "sampled_content_evidence": {
          "$ref": "#/$defs/contract"
        },
        "finding_code_policy": {
          "$ref": "#/$defs/contract"
        }
      }
    },
    "input_assurance": {
      "type": "object"
    },
    "source_finding_severity": {
      "type": "object"
    },
    "semantic_assurance": {
      "type": "object"
    },
    "min_content_length_by_product": {
      "type": "object"
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "content_sampling_profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-content-sampling-p3"
        },
        "schema_version": {
          "const": "1.0"
        },
        "path": {
          "const": "data/configs/content-sampling-profiles/v0.4-p3.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "finding_code_policy_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-finding-code-policy-p4"
        },
        "schema_version": {
          "const": "1.0"
        },
        "path": {
          "const": "data/configs/finding-code-policies/v0.4-p4.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
