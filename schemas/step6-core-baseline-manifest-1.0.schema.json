{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azurecnarchaeologist.local/schemas/step6-core-baseline-manifest-1.0.schema.json",
  "title": "Step 6 Core Baseline Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "matrix_id",
    "source_batch_id",
    "reason",
    "generated_at",
    "fixture_manifest_sha256",
    "planning",
    "validation_context",
    "frozen_inputs",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "baseline_id": { "const": "v0.4-step6-core-baseline" },
    "matrix_id": { "const": "v0.4-core-strategy-matrix" },
    "source_batch_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
    "reason": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "fixture_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "planning": { "type": "object" },
    "validation_context": { "type": "object" },
    "frozen_inputs": { "type": "object" },
    "items": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "language",
        "resource_key",
        "strategy",
        "payload_baseline",
        "content_baseline",
        "source_sha256",
        "payload_sha256",
        "validation_sha256"
      ],
      "properties": {
        "item_id": { "type": "string", "pattern": "^(zh-cn|en-us)/.+" },
        "language": { "enum": ["zh-cn", "en-us"] },
        "resource_key": { "enum": ["api-management", "cloud-services", "service-bus", "icp-faq"] },
        "strategy": { "enum": ["region_filter", "complex", "simple_static", "support_article"] },
        "payload_baseline": { "$ref": "#/$defs/relativePath" },
        "content_baseline": { "$ref": "#/$defs/relativePath" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "validation_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

