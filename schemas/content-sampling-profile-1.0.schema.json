{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/content-sampling-profile-1.0.schema.json",
  "title": "Content Sampling Profile 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "algorithm_version",
    "target_budget",
    "mandatory_anchors",
    "strategy_rules",
    "selection_policy",
    "seed_derivation",
    "comparison_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "const": "v0.4-content-sampling-p3"
    },
    "status": {
      "const": "frozen"
    },
    "algorithm_version": {
      "const": "source-ordered-stratified-sampling-v1"
    },
    "target_budget": {
      "const": 12
    },
    "mandatory_anchors": {
      "type": "array",
      "prefixItems": [
        {
          "const": "default_state"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "strategy_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simple_static",
        "support_article",
        "region_filter",
        "complex"
      ],
      "properties": {
        "simple_static": {
          "$ref": "#/$defs/full_strategy"
        },
        "support_article": {
          "$ref": "#/$defs/full_strategy"
        },
        "region_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage_mode",
            "sampling_plan",
            "stratum_dimension",
            "minimum_per_stratum"
          ],
          "properties": {
            "coverage_mode": {
              "const": "stratified_sample"
            },
            "sampling_plan": {
              "const": "required"
            },
            "stratum_dimension": {
              "const": "source_proven_region"
            },
            "minimum_per_stratum": {
              "const": 1
            }
          }
        },
        "complex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage_mode",
            "sampling_plan",
            "stratum_dimension",
            "parent_branch_definition",
            "minimum_per_stratum",
            "cartesian_expansion"
          ],
          "properties": {
            "coverage_mode": {
              "const": "stratified_sample"
            },
            "sampling_plan": {
              "const": "required"
            },
            "stratum_dimension": {
              "const": "actual_parent_branch"
            },
            "parent_branch_definition": {
              "const": "ordered_criteria_prefix_excluding_leaf"
            },
            "minimum_per_stratum": {
              "const": 1
            },
            "cartesian_expansion": {
              "const": "forbidden"
            }
          }
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "small_universe",
        "forced_coverage_over_budget",
        "first_pass",
        "stratum_order",
        "within_stratum_rank",
        "remainder",
        "output_order"
      ],
      "properties": {
        "small_universe": {
          "const": "select_all_when_universe_lte_effective_budget"
        },
        "forced_coverage_over_budget": {
          "const": "expand_effective_budget"
        },
        "first_pass": {
          "const": "one_per_stratum_by_seed_state_hash"
        },
        "stratum_order": {
          "const": "source_first_appearance"
        },
        "within_stratum_rank": {
          "const": "sha256-canonical-json-array-seed-state-id"
        },
        "remainder": {
          "const": "stable_stratum_round_robin"
        },
        "output_order": {
          "const": "source_order"
        }
      }
    },
    "seed_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "serialization",
        "ordered_inputs",
        "excluded_inputs"
      ],
      "properties": {
        "digest": {
          "const": "sha256"
        },
        "serialization": {
          "const": "canonical-json-utf8-sorted-keys-compact"
        },
        "ordered_inputs": {
          "type": "array",
          "prefixItems": [
            {
              "const": "algorithm_version"
            },
            {
              "const": "source_sha256"
            },
            {
              "const": "item_id"
            },
            {
              "const": "profile_sha256"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "excluded_inputs": {
          "type": "array",
          "prefixItems": [
            {
              "const": "payload_sha256"
            },
            {
              "const": "batch_id"
            },
            {
              "const": "time"
            },
            {
              "const": "process_random_state"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_global",
        "selected_state",
        "selected_state_failure",
        "replacement_draw"
      ],
      "properties": {
        "page_global": {
          "const": "full"
        },
        "selected_state": {
          "const": "complete_rendered_content"
        },
        "selected_state_failure": {
          "const": "fail_validation"
        },
        "replacement_draw": {
          "const": "forbidden"
        }
      }
    }
  },
  "$defs": {
    "full_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_mode",
        "sampling_plan"
      ],
      "properties": {
        "coverage_mode": {
          "const": "full"
        },
        "sampling_plan": {
          "const": "not_applicable"
        }
      }
    }
  }
}
