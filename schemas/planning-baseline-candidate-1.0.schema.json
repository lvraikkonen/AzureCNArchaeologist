{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/planning-baseline-candidate-1.0.schema.json",
  "title": "Planning Baseline Candidate 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "baseline_id",
    "target_path",
    "predecessor",
    "proposed_sha256",
    "state_diff",
    "rationale",
    "candidate_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": {
      "type": "string",
      "pattern": "^v0\\.5\\.1-planning-[0-9a-f]{12}$"
    },
    "baseline_id": { "const": "v0.5.1-planning-baseline" },
    "target_path": {
      "const": "data/baselines/v0.5/planning-baseline.json"
    },
    "predecessor": { "$ref": "#/$defs/identity" },
    "proposed_sha256": { "$ref": "#/$defs/sha256" },
    "state_diff": { "$ref": "#/$defs/pathSha" },
    "rationale": { "$ref": "#/$defs/pathSha" },
    "candidate_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^/" }
    },
    "pathSha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_version", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
