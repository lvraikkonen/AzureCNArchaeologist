{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/planning-baseline-manifest-1.0.schema.json",
  "title": "v0.4 Planning Baseline Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "source_acceptance", "summary", "items", "planning_deltas", "accounting"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_id": {"const": "v0.4-from-v0.3"},
    "source_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "batch_id", "acceptance_report", "summary_report", "identity_reconstruction_commit", "reconstruction_limitation"],
      "properties": {
        "version": {"const": "0.3.0"},
        "batch_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
        "acceptance_report": {"$ref": "#/$defs/artifact"},
        "summary_report": {"$ref": "#/$defs/artifact"},
        "identity_reconstruction_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "reconstruction_limitation": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "v03_runnable_denominator", "known_unsupported", "source_unavailable"],
      "properties": {
        "total": {"const": 434},
        "v03_runnable_denominator": {"const": 379},
        "known_unsupported": {"const": 54},
        "source_unavailable": {"const": 1}
      }
    },
    "items": {
      "type": "array",
      "minItems": 434,
      "maxItems": 434,
      "items": {"$ref": "#/$defs/item"}
    },
    "planning_deltas": {
      "type": "array",
      "items": {"$ref": "#/$defs/delta"}
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator", "retained_runnable", "reviewed_non_runnable", "accounted", "coverage"],
      "properties": {
        "denominator": {"const": 379},
        "retained_runnable": {"type": "integer", "minimum": 0},
        "reviewed_non_runnable": {"type": "integer", "minimum": 0},
        "accounted": {"const": 379},
        "coverage": {"const": "379/379"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullable_artifact": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "identity", "product_key", "resource_kind", "semantic_strategy", "v03_state", "v03_skip_reason", "source", "normalized_input", "product_definition", "v04_disposition", "delta_id"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^(?:zh-cn|en-us)/"},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "resource_key"],
          "properties": {
            "language": {"enum": ["zh-cn", "en-us"]},
            "resource_key": {"type": "string", "minLength": 1}
          }
        },
        "product_key": {"type": "string", "minLength": 1},
        "resource_kind": {"enum": ["current", "historical_version"]},
        "semantic_strategy": {"enum": ["simple_static", "region_filter", "complex", "support_article"]},
        "v03_state": {"enum": ["runnable", "known_unsupported", "source_unavailable"]},
        "v03_skip_reason": {"type": ["string", "null"]},
        "source": {"$ref": "#/$defs/nullable_artifact"},
        "normalized_input": {"$ref": "#/$defs/nullable_artifact"},
        "product_definition": {"$ref": "#/$defs/artifact"},
        "v04_disposition": {"enum": ["retained_runnable", "reviewed_non_runnable", "outside_denominator"]},
        "delta_id": {"type": ["string", "null"]}
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_id", "item_id", "prior_state", "proposed_state", "reason_code", "evidence", "product_definition_decision", "review"],
      "properties": {
        "delta_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "prior_state": {"const": "runnable"},
        "proposed_state": {"const": "planned_non_runnable"},
        "reason_code": {"type": "string", "minLength": 1},
        "evidence": {"type": "object", "minProperties": 1},
        "product_definition_decision": {"type": "object", "minProperties": 1},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "reviewer", "rationale"],
          "properties": {
            "verdict": {"const": "approved"},
            "reviewer": {"type": "string", "minLength": 1},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
