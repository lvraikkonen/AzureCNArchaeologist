{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/independent-fidelity-basis-1.0.schema.json",
  "title": "Independent Fidelity Reconstruction Basis 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basis_id",
    "batch_binding",
    "item_identity",
    "source_identity",
    "product_definition_identity",
    "soft_category_identity",
    "route_map_identity",
    "persisted_payload_identity",
    "verifier_profile",
    "reconstruction_profile_version",
    "wire_transform_version",
    "comparison_version",
    "states",
    "basis_semantic_identity"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "basis_id": { "type": "string", "minLength": 1 },
    "batch_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "input_manifest", "batch_manifest"],
      "properties": {
        "batch_id": { "type": "string", "minLength": 1 },
        "input_manifest": { "$ref": "#/$defs/pathSha" },
        "batch_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "revision"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "revision": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "item_identity": { "$ref": "#/$defs/itemIdentity" },
    "source_identity": { "$ref": "#/$defs/pathSha" },
    "product_definition_identity": { "$ref": "#/$defs/pathSha" },
    "soft_category_identity": { "$ref": "#/$defs/nullablePathSha" },
    "route_map_identity": { "$ref": "#/$defs/nullablePathSha" },
    "persisted_payload_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "batch_revision"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "batch_revision": { "type": "integer", "minimum": 0 }
      }
    },
    "verifier_profile": { "$ref": "#/$defs/profileIdentity" },
    "reconstruction_profile_version": {
      "const": "independent-state-reconstruction-v1"
    },
    "wire_transform_version": { "const": "independent-cms-wire-v1" },
    "comparison_version": { "const": "independent-html-comparison-v1" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stateBasis" }
    },
    "basis_semantic_identity": { "$ref": "#/$defs/semanticIdentity" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^/|(?:^|/)\\.\\.(?:/|$)" }
    },
    "pathSha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullablePathSha": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pathSha" }
      ]
    },
    "itemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "language",
        "resource_key",
        "product_key",
        "resource_kind"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "language": { "enum": ["zh-cn", "en-us"] },
        "resource_key": { "type": "string", "minLength": 1 },
        "product_key": { "type": "string", "minLength": 1 },
        "resource_kind": {
          "enum": ["current", "historical_version", "controlled_fixture"]
        }
      }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filterKey", "matchValues"],
      "properties": {
        "filterKey": { "type": "string", "minLength": 1 },
        "matchValues": { "type": "string", "minLength": 1 }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_selector",
        "content_selectors",
        "append_selectors"
      ],
      "properties": {
        "container_selector": { "type": "string", "minLength": 1 },
        "content_selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "append_selectors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stateBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "criteria",
        "locator",
        "retained_table_ids",
        "removed_table_ids"
      ],
      "properties": {
        "state_id": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        },
        "locator": { "$ref": "#/$defs/locator" },
        "retained_table_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "removed_table_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
