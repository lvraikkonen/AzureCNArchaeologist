{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/source-finding-1.0.schema.json",
  "title": "Source Finding 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "category",
    "severity",
    "message",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "code": {
      "enum": [
        "SOURCE_CHARSET_BOM_CONFLICT",
        "SOURCE_CHARSET_DECLARATIONS_CONFLICT",
        "SOURCE_CHARSET_DECLARATION_NOT_UTF8"
      ]
    },
    "category": {"const": "charset"},
    "severity": {"const": "warning"},
    "message": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_encoding", "utf8_bom", "declarations"],
      "properties": {
        "actual_encoding": {"const": "utf-8"},
        "utf8_bom": {"type": "boolean"},
        "declarations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "value", "normalized"],
            "properties": {
              "source": {"enum": ["meta_charset", "http_equiv"]},
              "value": {"type": "string", "minLength": 1},
              "normalized": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
