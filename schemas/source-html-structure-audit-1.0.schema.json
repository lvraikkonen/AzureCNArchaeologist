{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/source-html-structure-audit-1.0.schema.json",
  "title": "Source HTML Structure Audit 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "auditor_version",
    "source",
    "passed",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "auditor_version": {
      "const": "exact-owned-boundaries-static-page-global-ids-and-post-selector-scope-v2"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_key",
        "resource_key",
        "language",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "product_key": {"type": "string", "minLength": 1},
        "resource_key": {"type": "string", "minLength": 1},
        "language": {"enum": ["zh-cn", "en-us"]},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "passed": {"type": "boolean"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"passed": {"const": true}}},
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["blocking"],
                "properties": {"blocking": {"const": true}}
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "contains": {
              "type": "object",
              "required": ["blocking"],
              "properties": {"blocking": {"const": true}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "dom_path", "description"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "dom_path": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "description", "from_line", "before_line"],
      "properties": {
        "action": {
          "enum": [
            "clarify_support_section_ownership",
            "materialize_state_content_inside_selector",
            "merge_heading_with_pricing_table_section",
            "move_visible_content_into_owned_faq",
            "relocate_existing_closing_tag",
            "remove_redundant_or_make_id_unique",
            "restore_exact_common_section_terminal",
            "return_footnote_to_state_panel",
            "separate_embedded_style_from_common_section",
            "split_ambiguous_common_section_wrapper"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "from_line": {"type": "integer", "minimum": 1},
        "before_line": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "blocking",
        "message",
        "evidence",
        "upstream_suggestion",
        "safety_checks"
      ],
      "properties": {
        "code": {
          "enum": [
            "SOURCE_HTML_COMMON_SECTION_BOUNDARY_NOT_EXACT",
            "SOURCE_HTML_CONTENT_WITHOUT_EXACT_COMMON_BOUNDARY",
            "SOURCE_HTML_DUPLICATE_ID_IN_BUSINESS_CONTENT",
            "SOURCE_HTML_POST_SELECTOR_CONTENT_NOT_EXACT_SECTION",
            "SOURCE_HTML_POST_SELECTOR_SUPPORT_SECTION_UNCLASSIFIED",
            "SOURCE_HTML_PRICING_SECTION_OVERWRAPS_SELECTOR_AND_QA",
            "SOURCE_HTML_PRICING_TABLE_SECTION_WITHOUT_OWN_HEADING",
            "SOURCE_HTML_SELECTOR_EXTENDS_PAST_TAB_CONTROL"
          ]
        },
        "severity": {"enum": ["warning", "error"]},
        "blocking": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "upstream_suggestion": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/suggestion"}
          ]
        },
        "safety_checks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "adjacent_pricing_section_pair",
              "classless_visible_pricing_content",
              "common_section_boundary_not_exact",
              "contains_exact_common_section_boundary",
              "direct_sibling_after_final_formal_selector",
              "dom_exact_qa_or_owned_sla",
              "embedded_style_sibling",
              "exact_following_common_section_boundary",
              "heading_section_has_no_table",
              "intro_precedes_selector",
              "multiple_empty_runtime_fetch_targets",
              "no_active_filter_controls",
              "no_exact_faq_or_sla_boundary",
              "no_nested_formal_selector",
              "non_empty_duplicate_id",
              "owned_support_only_heading",
              "post_selector_pricing_sections_present",
              "post_selector_tags_date_footnote",
              "pricing_context_requires_state_ownership",
              "raw_balanced_target_element",
              "relocation_preserves_content_order",
              "site_template_scope_excluded",
              "sole_static_formal_selector_scope",
              "split_heading_table_sections_present",
              "standalone_closing_tag_line",
              "support_contact_link_present",
              "table_section_has_no_owned_heading",
              "tab_control_boundary_comment",
              "visible_content_outside_owned_faq",
              "wrapper_spans_multiple_common_sections"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "const": "SOURCE_HTML_DUPLICATE_ID_IN_BUSINESS_CONTENT"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {"const": "error"},
              "blocking": {"const": true},
              "upstream_suggestion": {
                "allOf": [
                  {"$ref": "#/$defs/suggestion"},
                  {
                    "properties": {
                      "action": {
                        "const": "remove_redundant_or_make_id_unique"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "enum": [
                  "SOURCE_HTML_COMMON_SECTION_BOUNDARY_NOT_EXACT",
                  "SOURCE_HTML_CONTENT_WITHOUT_EXACT_COMMON_BOUNDARY",
                  "SOURCE_HTML_POST_SELECTOR_CONTENT_NOT_EXACT_SECTION",
                  "SOURCE_HTML_POST_SELECTOR_SUPPORT_SECTION_UNCLASSIFIED",
                  "SOURCE_HTML_PRICING_TABLE_SECTION_WITHOUT_OWN_HEADING"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "severity": {"const": "error"},
              "blocking": {"const": true},
              "upstream_suggestion": {"$ref": "#/$defs/suggestion"}
            }
          }
        },
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "const": "SOURCE_HTML_COMMON_SECTION_BOUNDARY_NOT_EXACT"
              }
            }
          },
          "then": {
            "properties": {
              "upstream_suggestion": {
                "allOf": [
                  {"$ref": "#/$defs/suggestion"},
                  {
                    "properties": {
                      "action": {
                        "enum": [
                          "move_visible_content_into_owned_faq",
                          "separate_embedded_style_from_common_section",
                          "split_ambiguous_common_section_wrapper"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "const": "SOURCE_HTML_POST_SELECTOR_CONTENT_NOT_EXACT_SECTION"
              }
            }
          },
          "then": {
            "properties": {
              "upstream_suggestion": {
                "allOf": [
                  {"$ref": "#/$defs/suggestion"},
                  {
                    "properties": {
                      "action": {
                        "enum": [
                          "materialize_state_content_inside_selector",
                          "return_footnote_to_state_panel"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "const": "SOURCE_HTML_PRICING_TABLE_SECTION_WITHOUT_OWN_HEADING"
              }
            }
          },
          "then": {
            "properties": {
              "upstream_suggestion": {
                "allOf": [
                  {"$ref": "#/$defs/suggestion"},
                  {
                    "properties": {
                      "action": {
                        "const": "merge_heading_with_pricing_table_section"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "const": "SOURCE_HTML_CONTENT_WITHOUT_EXACT_COMMON_BOUNDARY"
              }
            }
          },
          "then": {
            "properties": {
              "upstream_suggestion": {
                "allOf": [
                  {"$ref": "#/$defs/suggestion"},
                  {
                    "properties": {
                      "action": {
                        "const": "restore_exact_common_section_terminal"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "const": "SOURCE_HTML_POST_SELECTOR_SUPPORT_SECTION_UNCLASSIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "upstream_suggestion": {
                "allOf": [
                  {"$ref": "#/$defs/suggestion"},
                  {
                    "properties": {
                      "action": {
                        "const": "clarify_support_section_ownership"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["code"],
            "properties": {
              "code": {
                "enum": [
                  "SOURCE_HTML_PRICING_SECTION_OVERWRAPS_SELECTOR_AND_QA",
                  "SOURCE_HTML_SELECTOR_EXTENDS_PAST_TAB_CONTROL"
                ]
              }
            }
          },
          "then": {
            "if": {
              "required": ["blocking"],
              "properties": {"blocking": {"const": true}}
            },
            "then": {
              "properties": {
                "severity": {"const": "error"},
                "upstream_suggestion": {"type": "null"}
              }
            },
            "else": {
              "properties": {
                "severity": {"const": "warning"},
                "upstream_suggestion": {"$ref": "#/$defs/suggestion"}
              }
            }
          }
        }
      ]
    }
  }
}
