{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure.cn/archaeologist/schemas/release-manifest-1.0.schema.json",
  "title": "Release Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "batch_id",
    "batch_manifest",
    "input_manifest",
    "validation_profile",
    "content_sampling_profile",
    "target",
    "assurance",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "batch_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "input_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "validation_profile": {
      "$ref": "#/$defs/validation_profile_identity"
    },
    "content_sampling_profile": {
      "$ref": "#/$defs/sampling_profile_identity"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "assurance": {
      "$ref": "#/$defs/assurance"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/release_item"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation_profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-validation-p3"
        },
        "schema_version": {
          "const": "1.2"
        },
        "path": {
          "const": "data/configs/validation-profiles/v0.4-p3.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sampling_profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "const": "v0.4-content-sampling-p3"
        },
        "schema_version": {
          "const": "1.0"
        },
        "path": {
          "const": "data/configs/content-sampling-profiles/v0.4-p3.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_url",
        "container",
        "prefix"
      ],
      "properties": {
        "account_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "container": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?$"
        },
        "prefix": {
          "type": "string",
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            ]
          }
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_scope",
        "content_claim",
        "excluded_claims"
      ],
      "properties": {
        "structural_scope": {
          "const": "all_source_proven_reachable_states"
        },
        "content_claim": {
          "const": "sampled_state_content_consistency"
        },
        "excluded_claims": {
          "type": "array",
          "prefixItems": [
            {
              "const": "unselected_state_content_consistency"
            },
            {
              "const": "complete_pricing_fact_fidelity"
            },
            {
              "const": "commercial_price_accuracy"
            },
            {
              "const": "visual_equivalence"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "release_path",
        "sha256"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/relative_path"
        },
        "release_path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "release_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_sha256",
        "validation_artifact_sha256",
        "validation_evidence_sha256",
        "review_decision_sha256",
        "validation_profile_sha256",
        "sampling_plan_sha256"
      ],
      "properties": {
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validation_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validation_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_decision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validation_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sampling_plan_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "universe_count",
        "selected_count",
        "untested_count"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "stratified_sample"
          ]
        },
        "universe_count": {
          "type": "integer",
          "minimum": 1
        },
        "selected_count": {
          "type": "integer",
          "minimum": 1
        },
        "untested_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target_blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "name"
      ],
      "properties": {
        "container": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            ]
          }
        }
      }
    },
    "release_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "resource_key",
        "language",
        "payload",
        "validation_path",
        "review_decision_path",
        "review_decision_id",
        "bindings",
        "coverage",
        "target_blob"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "language": {
          "enum": [
            "zh-cn",
            "en-us"
          ]
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "validation_path": {
          "$ref": "#/$defs/relative_path"
        },
        "review_decision_path": {
          "$ref": "#/$defs/relative_path"
        },
        "review_decision_id": {
          "$ref": "#/$defs/sha256"
        },
        "bindings": {
          "$ref": "#/$defs/release_bindings"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "target_blob": {
          "$ref": "#/$defs/target_blob"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "properties": {
                  "mode": {
                    "const": "full"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "untested_count": {
                    "const": 0
                  }
                }
              },
              "bindings": {
                "properties": {
                  "sampling_plan_sha256": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "bindings": {
                "properties": {
                  "sampling_plan_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
